{
  "rewrites": [
    {
      "source": "/crossword",
      "destination": "/crossword.html"
    },
    {
      "source": "/crossword/",
      "destination": "/crossword.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admin/",
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/newsletter",
      "destination": "/#investors-club",
      "permanent": false
    },
    {
      "source": "/newsletter.html",
      "destination": "/#investors-club",
      "permanent": false
    }
  ]
}
